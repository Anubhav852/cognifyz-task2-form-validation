<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submission Successful</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <div class="result-card">
      <div class="success-icon">✓</div>
      <h1>Registration Successful!</h1>
      <p>Your details have been saved successfully.</p>

      <div class="result-items">
        <div class="result-item">
          <span class="label">Full Name</span>
          <span class="value"><%= submission.name %></span>
        </div>

        <div class="result-item">
          <span class="label">Email</span>
          <span class="value"><%= submission.email %></span>
        </div>

        <div class="result-item">
          <span class="label">Phone</span>
          <span class="value"><%= submission.phone %></span>
        </div>

        <div class="result-item">
          <span class="label">Age</span>
          <span class="value"><%= submission.age %></span>
        </div>

        <div class="result-item">
          <span class="label">Submitted At</span>
          <span class="value"><%= submission.submittedAt %></span>
        </div>
      </div>

      <a href="/" class="back-btn">Register Another</a>
    </div>
  </div>
</body>
</html>